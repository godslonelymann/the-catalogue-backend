# /etc/caddy/Caddyfile
the-catalogue.duckdns.org {
    reverse_proxy localhost:8000

    # Access log (JSON, one line per request). Caddy rolls it itself: 10 MB per file, keeps 5.
    # Read it with: sudo tail -f /var/log/caddy/access.log
    log {
        output file /var/log/caddy/access.log {
            roll_size 10MiB
            roll_keep 5
        }
    }
}
