# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/brands
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=123456789
# Comma-separated list of frontend origins allowed by CORS (no trailing slash).
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Optional, only for tests/test_api.py: an empty, throwaway database (admin user).
# The tests drop and recreate the catalog and app schemas in it.
# TEST_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/catalogue_test
